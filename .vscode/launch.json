{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Senpy Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/senpy-vscode"
            ],
            "outFiles": [
                "${workspaceFolder}/senpy-vscode/out/**/*.js"
            ],
            "preLaunchTask": "npm: compile"
        }
    ]
}