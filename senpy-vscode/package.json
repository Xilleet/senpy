{
  "publisher": "Xilleet",
  "name": "senpy-vscode",
  "displayName": "Senpy — Ren'Py Linter & Language Server",
  "description": "Fast static analyzer, semantic linter and Language Server for Ren'Py visual novels. Detects undefined variables, broken labels, control-flow bugs, save/rollback issues and translation errors in real time.",
  "version": "0.7.7",
  "engines": {
    "vscode": "^1.85.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "renpy",
    "ren'py",
    "visual novel",
    "linter",
    "static analysis",
    "language server",
    "lsp",
    "code quality",
    "game development",
    "translation",
    "localization",
    "save safety",
    "rollback",
    "story graph",
    "rpy"
  ],
  "galleryBanner": {
    "color": "#1f1f28",
    "theme": "dark"
  },
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xilleet/senpy"
  },
  "bugs": {
    "url": "https://github.com/Xilleet/senpy/issues"
  },
  "homepage": "https://github.com/Xilleet/senpy#readme",
  "activationEvents": [
    "onLanguage:renpy",
    "onCommand:senpy.showStoryGraph",
    "workspaceContains:**/*.rpy"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "senpy.showStoryGraph",
        "title": "Senpy: Show Story Graph",
        "icon": "$(git-merge)"
      },
      {
        "command": "senpy.showStoryStats",
        "title": "Senpy: Show Story & Character Analytics",
        "icon": "$(graph-line)"
      },
      {
        "command": "senpy.restartLanguageServer",
        "title": "Senpy: Restart Language Server",
        "category": "Senpy"
      },
      {
        "command": "senpy.openExternal",
        "title": "Senpy: Open File in Default App",
        "category": "Senpy",
        "enablement": "false"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "senpy.showStoryGraph",
          "when": "resourceLangId == renpy",
          "group": "navigation"
        },
        {
          "command": "senpy.showStoryStats",
          "when": "resourceLangId == renpy",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "senpy.showStoryGraph"
        },
        {
          "command": "senpy.showStoryStats"
        },
        {
          "command": "senpy.restartLanguageServer"
        }
      ]
    },
    "languages": [
      {
        "id": "renpy",
        "aliases": [
          "Ren'Py",
          "renpy"
        ],
        "extensions": [
          ".rpy",
          ".rpym"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "renpy",
        "scopeName": "source.renpy",
        "path": "./syntaxes/renpy.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Senpy",
      "properties": {
        "senpy.executablePath": {
          "type": "string",
          "default": "",
          "description": "Custom path to senpy executable (e.g. C:/Python311/Scripts/senpy.exe or /usr/local/bin/senpy)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  }
}
