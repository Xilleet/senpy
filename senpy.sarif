{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Senpy Linter",
          "informationUri": "https://github.com/Xilleet/senpy",
          "rules": [
            {
              "id": "RPY001",
              "shortDescription": {
                "text": "Tab character in indentation"
              },
              "fullDescription": {
                "text": "Ren'Py requires 4 spaces per indentation level. Tab characters ('\\t') cause indentation mismatches and SyntaxError across different editors and operating systems."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy001"
            },
            {
              "id": "RPY002",
              "shortDescription": {
                "text": "Smart/curly quotes in code statement"
              },
              "fullDescription": {
                "text": "Typographic smart quotes (“ ” ‘ ’ « ») copied from text editors like MS Word into Python code statements cause a fatal SyntaxError."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy002"
            },
            {
              "id": "RPY101",
              "shortDescription": {
                "text": "Unresolved variable in dialogue interpolation"
              },
              "fullDescription": {
                "text": "Using [variable] in dialogue when it is not declared via 'default' or 'define' will crash the game with KeyError during text rendering."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy101"
            },
            {
              "id": "RPY102",
              "shortDescription": {
                "text": "Augmented assignment before 'default' declaration"
              },
              "fullDescription": {
                "text": "Doing +=, -=, etc. to a variable before it has been initialized causes an immediate runtime NameError when entering the scene."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy102"
            },
            {
              "id": "RPY103",
              "shortDescription": {
                "text": "Undeclared variable in condition"
              },
              "fullDescription": {
                "text": "Evaluating 'if var:' or 'elif var:' crashes the engine with NameError if the variable was never declared."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy103"
            },
            {
              "id": "RPY104",
              "shortDescription": {
                "text": "Dynamic assignment without top-level 'default'"
              },
              "fullDescription": {
                "text": "Assigning variables on the fly ($ var = 1) without a top-level 'default' will corrupt save files upon game updates and cause NameError on other story branches."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy104"
            },
            {
              "id": "RPY105",
              "shortDescription": {
                "text": "Direct mutation of 'define' constant"
              },
              "fullDescription": {
                "text": "Variables declared with 'define' are static constants (characters, configurations). Modifying them breaks Ren'Py rollback and save persistence."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy105"
            },
            {
              "id": "RPY106",
              "shortDescription": {
                "text": "Usage of non-revertable Python types (random / mutable set)"
              },
              "fullDescription": {
                "text": "Standard Python 'import random' and mutable 'set()' are not tracked by Ren'Py's rollback engine. Players rolling back will experience save desynchronization."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy106"
            },
            {
              "id": "RPY107",
              "shortDescription": {
                "text": "Usage of deprecated / obsolete Ren'Py API"
              },
              "fullDescription": {
                "text": "Calling obsolete Ren'Py functions (LiveComposite, DynamicCharacter, im.*, ui.*) harms rendering performance (CPU vs GPU) or breaks on Ren'Py 7/8."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy107"
            },
            {
              "id": "RPY201",
              "shortDescription": {
                "text": "Direct state mutation inside screen"
              },
              "fullDescription": {
                "text": "Screens are evaluated continuously and predictively by the UI loop. Direct state mutations run repeatedly every frame and break rollback."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy201"
            },
            {
              "id": "RPY202",
              "shortDescription": {
                "text": "Screen accesses variable without 'default'"
              },
              "fullDescription": {
                "text": "Screens can be evaluated before story start (e.g. in the main menu or prediction loop). Reading undeclared variables crashes the game."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy202"
            },
            {
              "id": "RPY203",
              "shortDescription": {
                "text": "Button without 'action' argument"
              },
              "fullDescription": {
                "text": "Buttons (textbutton, imagebutton) without an 'action' property are non-interactive dead UI elements."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy203"
            },
            {
              "id": "RPY204",
              "shortDescription": {
                "text": "Call/Show to non-existent screen"
              },
              "fullDescription": {
                "text": "Calling or showing a screen that does not exist crashes the game with 'Exception: Screen is not known'."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy204"
            },
            {
              "id": "RPY205",
              "shortDescription": {
                "text": "Imperative Python loop inside screen"
              },
              "fullDescription": {
                "text": "Writing imperative for/while loops in Python blocks inside screens severely hurts UI prediction and causes frame drops."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy205"
            },
            {
              "id": "RPY206",
              "shortDescription": {
                "text": "Direct function call in button action"
              },
              "fullDescription": {
                "text": "Directly calling a function with parentheses in action executes it immediately during screen render, not upon user click."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy206"
            },
            {
              "id": "RPY301",
              "shortDescription": {
                "text": "Unclosed or mismatched text tag in dialogue"
              },
              "fullDescription": {
                "text": "Unclosed tags like {b} will bleed styles into all subsequent dialogues across the entire game."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy301"
            },
            {
              "id": "RPY302",
              "shortDescription": {
                "text": "Jump or Call to non-existent label"
              },
              "fullDescription": {
                "text": "Jumping to a label that does not exist immediately terminates the novel with ScriptError."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy302"
            },
            {
              "id": "RPY303",
              "shortDescription": {
                "text": "Unreferenced / Dead label"
              },
              "fullDescription": {
                "text": "Label is declared but never called or jumped to anywhere in the project. It might be dead code or a forgotten draft."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy303"
            },
            {
              "id": "RPY304",
              "shortDescription": {
                "text": "Malformed color in {color} tag"
              },
              "fullDescription": {
                "text": "Typo in hex code (e.g. #12345) or unknown color name causes the Ren'Py text renderer to crash."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy304"
            },
            {
              "id": "RPY305",
              "shortDescription": {
                "text": "Unescaped quotes inside dialogue string"
              },
              "fullDescription": {
                "text": "Quotes inside a dialogue string without escaping (\\\") break the string literal parser at startup."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy305"
            },
            {
              "id": "RPY306",
              "shortDescription": {
                "text": "Called label without 'return' statement"
              },
              "fullDescription": {
                "text": "Invoking a label via 'call' expects a 'return'. Without it, control flow accidentally bleeds into unrelated scenes."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy306"
            },
            {
              "id": "RPY307",
              "shortDescription": {
                "text": "Duplicate label declaration"
              },
              "fullDescription": {
                "text": "Declaring two labels with the same name across any project script causes a fatal ScriptError on startup."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy307"
            },
            {
              "id": "RPY308",
              "shortDescription": {
                "text": "Label preceded by regular statements (Fallthrough hazard)"
              },
              "fullDescription": {
                "text": "Ending a scene without 'jump' or 'return' before the next label causes control flow to unintentionally fall right through into the next scene."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy308"
            },
            {
              "id": "RPY401",
              "shortDescription": {
                "text": "Variable defined in one menu choice but missing in another"
              },
              "fullDescription": {
                "text": "If Choice A defines a variable but Choice B does not, choosing Choice B and later reading the variable causes a fatal NameError."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy401"
            },
            {
              "id": "RPY402",
              "shortDescription": {
                "text": "Empty menu choice"
              },
              "fullDescription": {
                "text": "A menu choice was defined without any body statements, causing the story to immediately fall through."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy402"
            },
            {
              "id": "RPY403",
              "shortDescription": {
                "text": "Always-false or contradictory condition"
              },
              "fullDescription": {
                "text": "Conditions like 'if False:' or 'if x and not x:' can never be true. The code block will never execute."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy403"
            },
            {
              "id": "RPY501",
              "shortDescription": {
                "text": "Missing audio file"
              },
              "fullDescription": {
                "text": "Audio file referenced in play/queue music/sound/voice does not exist on disk, in 'audio/', or inside .rpa archives."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy501"
            },
            {
              "id": "RPY502",
              "shortDescription": {
                "text": "Missing or mistyped sprite / background"
              },
              "fullDescription": {
                "text": "Sprite pose or background shown via 'show' or 'scene' is missing from image declarations, layered images, and asset folders."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy502"
            },
            {
              "id": "RPY503",
              "shortDescription": {
                "text": "Unused media asset on disk"
              },
              "fullDescription": {
                "text": "Image or audio files located in the project directory are never referenced in any script. Increases build distribution size."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy503"
            },
            {
              "id": "RPY504",
              "shortDescription": {
                "text": "Duplicate / overridden image declaration"
              },
              "fullDescription": {
                "text": "Declaring the same image tag twice (via 'image name = ...' or 'image name:') silently overrides the previous definition."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy504"
            },
            {
              "id": "RPY601",
              "shortDescription": {
                "text": "Variable mismatch in translation string"
              },
              "fullDescription": {
                "text": "If a translated string alters or misspells a dialogue variable ([var]), rendering the translation causes a fatal KeyError at runtime."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy601"
            },
            {
              "id": "RPY602",
              "shortDescription": {
                "text": "Formatting tag mismatch in translation string"
              },
              "fullDescription": {
                "text": "Missing or altered formatting tags ({b}, {color}, {i}) in translation strings cause unclosed text tags and visual glitches."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy602"
            },
            {
              "id": "RPY603",
              "shortDescription": {
                "text": "Empty translation string ('new \"\"')"
              },
              "fullDescription": {
                "text": "Leaving 'new \"\"' empty for a non-empty original line will display an empty, blank dialogue window to players in that language."
              },
              "helpUri": "https://github.com/Xilleet/senpy/blob/main/RULES.md#rpy603"
            },
            {
              "id": "RPY309",
              "shortDescription": {
                "text": "Rule RPY309"
              }
            }
          ]
        }
      },
